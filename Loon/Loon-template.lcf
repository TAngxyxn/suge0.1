[General]
ip-mode = v4-only
ipv6-vif = off
dns-server = 223.5.5.5,119.29.29.29
doh-server = https://223.5.5.5/dns-query,https://1.12.12.12/dns-query
allow-wifi-access = false
wifi-access-http-port = 7222
wifi-access-socks5-port = 7221
test-timeout = 5
interface-mode = auto
proxy-test-url = http://www.gstatic.com/generate_204
internet-test-url = http://wifi.vivo.com.cn/generate_204
skip-proxy = 192.168.0.0/16,10.0.0.0/9,10.128.0.0/9,172.16.0.0/12,localhost,*.local

[Proxy]

[Remote Proxy]
# 安全模板：机场订阅只在本机 Loon 中添加，不要把真实 URL/token 写入公开仓库。
# WCloud：在本机添加，建议 enabled=true
# TAG：保留为备用订阅；需要时在本机启用
# 顺畅：在本机添加，建议 enabled=true

[Remote Filter]
境外AI节点 = NameRegex, FilterKey = "(?i)^(?!.*(中国|大陆|CN|China|回国|境内|内地|香港|HK|HKG|Hong|🇭🇰)).*$"
全部节点 = NameRegex, FilterKey = ".*"
香港节点 = NameRegex, FilterKey = "(?i)(香港|🇭🇰|(?:^|[^a-z])(?:hk|hong[ _-]?kong)(?:[^a-z]|$))"
日本节点 = NameRegex, FilterKey = "(?i)(日本|🇯🇵|(?:^|[^a-z])(?:jp|japan)(?:[^a-z]|$))"
新加坡节点 = NameRegex, FilterKey = "(?i)(新加坡|狮城|獅城|🇸🇬|(?:^|[^a-z])(?:sg|singapore)(?:[^a-z]|$))"
台湾节点 = NameRegex, FilterKey = "(?i)(台湾|台灣|臺灣|🇹🇼|(?:^|[^a-z])(?:tw|taiwan)(?:[^a-z]|$))"
美国节点 = NameRegex, FilterKey = "(?i)(美国|美國|🇺🇸|(?:^|[^a-z])(?:us|usa|united[ _-]?states)(?:[^a-z]|$))"

[Proxy Group]
AI-最优节点 = select,美国节点,新加坡节点,日本节点,url = http://www.gstatic.com/generate_204
故障转移 = fallback,全部节点,url = http://www.gstatic.com/generate_204,interval = 60,max-timeout = 3000
自动优选 = select,全部节点,url = http://www.gstatic.com/generate_204
香港自动优选 = url-test,香港节点,url = http://www.gstatic.com/generate_204,interval = 60,tolerance = 50
香港故障转移 = fallback,香港节点,url = http://www.gstatic.com/generate_204,interval = 60,max-timeout = 3000
香港节点选择 = select,香港自动优选,香港故障转移,香港节点
日本自动优选 = url-test,日本节点,url = http://www.gstatic.com/generate_204,interval = 60,tolerance = 50
日本故障转移 = fallback,日本节点,url = http://www.gstatic.com/generate_204,interval = 60,max-timeout = 3000
日本节点选择 = select,日本自动优选,日本故障转移,日本节点
新加坡自动优选 = url-test,新加坡节点,url = http://www.gstatic.com/generate_204,interval = 60,tolerance = 50
新加坡故障转移 = fallback,新加坡节点,url = http://www.gstatic.com/generate_204,interval = 60,max-timeout = 3000
新加坡节点选择 = select,新加坡自动优选,新加坡故障转移,新加坡节点
台湾自动优选 = url-test,台湾节点,url = http://www.gstatic.com/generate_204,interval = 60,tolerance = 50
台湾故障转移 = fallback,台湾节点,url = http://www.gstatic.com/generate_204,interval = 60,max-timeout = 3000
台湾节点选择 = select,台湾自动优选,台湾故障转移,台湾节点
美国自动优选 = url-test,美国节点,url = http://www.gstatic.com/generate_204,interval = 60,tolerance = 50
美国故障转移 = fallback,美国节点,url = http://www.gstatic.com/generate_204,interval = 60,max-timeout = 3000
美国节点选择 = select,美国自动优选,美国故障转移,美国节点
节点选择 = select,自动优选,故障转移,香港节点选择,日本节点选择,新加坡节点选择,台湾节点选择,美国节点选择,全部节点
Google = select,美国节点选择,美国节点
Telegram = url-test,全部节点,节点选择,香港节点选择,日本节点选择,新加坡节点选择,台湾节点选择,美国节点选择,interval = 600
Twitter = select,节点选择,香港节点选择,日本节点选择,新加坡节点选择,台湾节点选择,美国节点选择,全部节点
GitHub = select,节点选择,香港节点选择,日本节点选择,新加坡节点选择,台湾节点选择,美国节点选择,全部节点
YouTube = select,节点选择,香港节点选择,日本节点选择,新加坡节点选择,台湾节点选择,美国节点选择,全部节点
OpenAI = select,美国节点选择,美国节点
Claude = select,美国节点选择,美国节点
Gemini = select,美国节点选择,日本节点选择,日本节点,美国节点,日本故障转移
广告拦截 = select,AI-最优节点,美国自动优选

[Rule]
IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
IP-CIDR,1.12.12.12/32,DIRECT,no-resolve
FINAL,美国自动优选

[Remote Rule]
https://raw.githubusercontent.com/QuixoticHeart/rule-set/refs/heads/ruleset/loon/apns.list, policy=DIRECT, tag=apns.list, enabled=true
https://rule.kelee.one/Loon/Advertising.lsr, policy=广告拦截, tag=Advertising, enabled=true
https://rule.kelee.one/Loon/WeChat.lsr, policy=DIRECT, tag=WeChat, enabled=true
https://rule.kelee.one/Loon/GaoDe.lsr, policy=DIRECT, tag=GaoDe, enabled=true
