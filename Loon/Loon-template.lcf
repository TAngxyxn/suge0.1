https://rule.kelee.one/Loon/OpenAI.lsr, policy=OpenAI, tag=OpenAI, enabled=true
https://rule.kelee.one/Loon/Claude.lsr, policy=Claude, tag=Claude, enabled=true
https://rule.kelee.one/Loon/Gemini.lsr, policy=Gemini, tag=Gemini, enabled=true
