#!name=顺畅网络增强规则
#!desc=适配顺畅网络托管配置，使用现有 Proxy 策略；增强 Gemini、ChatGPT、Siri ChatGPT、Telegram、海外媒体及广告拦截
#!category=自定义
[Rule]
# AI services
RULE-SET,https://raw.githubusercontent.com/TAngxyxn/suge0.1/main/AI.list,Proxy
# Siri ChatGPT relay must precede generic Apple DIRECT rules
DOMAIN,apple-relay.apple.com,Proxy
# Telegram
RULE-SET,https://raw.githubusercontent.com/TAngxyxn/suge0.1/main/Telegram.list,Proxy
# Google services
RULE-SET,https://raw.githubusercontent.com/TAngxyxn/suge0.1/main/Google.list,Proxy
# Overseas media
RULE-SET,https://raw.githubusercontent.com/TAngxyxn/suge0.1/main/Media.list,Proxy
# Common ads
RULE-SET,https://raw.githubusercontent.com/TAngxyxn/suge0.1/main/Ads.list,REJECT
